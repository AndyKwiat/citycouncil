<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily update at 19:00, when this Mac is usually awake (PLAN 4.10). If it is asleep then, launchd runs the job once
     at the next wake; if it is switched off, that day is skipped. caffeinate -i keeps it awake while the job runs.
     Template: tools/launchd/install.sh fills in {{REPO}} and {{PATH}} and writes
     ~/Library/LaunchAgents/ca.cityhallvotes.update.plist.
       turn on:   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ca.cityhallvotes.update.plist
       run now:   launchctl kickstart gui/$(id -u)/ca.cityhallvotes.update
       turn off:  launchctl bootout gui/$(id -u)/ca.cityhallvotes.update
     The report is state/update_report.json; output goes to state/logs/update.log. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ca.cityhallvotes.update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>{{REPO}}/.venv/bin/python</string>
    <string>{{REPO}}/pipeline.py</string><string>update</string><string>--publish</string>
  </array>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{{PATH}}</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>{{REPO}}/state/logs/update.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/state/logs/update.log</string>
</dict>
</plist>
