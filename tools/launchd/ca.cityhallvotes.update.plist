<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly update at 05:30 (PLAN 4.10). Not loaded automatically. To turn it on:
       cp tools/launchd/ca.cityhallvotes.update.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/ca.cityhallvotes.update.plist
     The report is state/update_report.json; output goes to state/logs/update.log. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ca.cityhallvotes.update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>~/src/citycouncil/.venv/bin/python</string>
    <string>~/src/citycouncil/pipeline.py</string><string>update</string><string>--publish</string>
  </array>
  <key>WorkingDirectory</key><string>~/src/citycouncil</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>~/src/citycouncil/state/logs/update.log</string>
  <key>StandardErrorPath</key><string>~/src/citycouncil/state/logs/update.log</string>
</dict>
</plist>
