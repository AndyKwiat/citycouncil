# Copy to .env (untracked) and fill in for your own deployment. Real environment variables take precedence.

# File holding CLOUDFLARE_WORKERS_TOKEN=... (never commit it).
CITYCOUNCIL_SECRETS=~/.config/citycouncil/secrets.env

# Public hostname of the search API that the Cloudflare Worker forwards /api/search to.
CITYCOUNCIL_SEARCH_HOST=api.example.com

# radify app name for the search API, and the radify CLI.
CITYCOUNCIL_SEARCH_APP=api-citycouncil
RADIFY=~/radify/bin/radify

# Optional: SSH alias for the server, used only to check the search app's memory limit.
CITYCOUNCIL_SSH=
