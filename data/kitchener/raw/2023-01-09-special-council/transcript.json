  "end": 164.0,
  "text": "The motion that's before us is that funding of $158,621 for the services provided by House",
  "no_speech": 0.0,
  "logprob": -0.138,
  "source": "whisper"
 },
 {
  "start": 164.0,
  "end": 168.5,
  "text": "of Friendship be moved from the Tier 1 grant program and placed into the neighbourhood",
  "no_speech": 0.0,
  "logprob": -0.138,
  "source": "whisper"
 },
 {
