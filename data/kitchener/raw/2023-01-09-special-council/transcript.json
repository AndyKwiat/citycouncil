 {
  "start": 90.0,
  "end": 110.5,
  "text": "Good morning everyone and welcome to today's special council meeting, the 1st of 2023,",
  "no_speech": 0.0,
  "logprob": -0.264,
  "source": "whisper"
 },
 {
  "start": 110.5,
  "end": 112.6,
  "text": "on January 9th.",
  "no_speech": 0.0,
  "logprob": -0.264,
  "source": "whisper"
 },
 {
  "start": 112.6,
  "end": 115.7,
  "text": "As we begin this morning's meeting, I'd like to acknowledge that today we're gathering",
  "no_speech": 0.0,
  "logprob": -0.264,
  "source": "whisper"
 },
 {
  "start": 115.7,
  "end": 120.4,
  "text": "on the traditional territory of the neutral, Anishinaabe and Haudenosaunee peoples.",
  "no_speech": 0.0,
  "logprob": -0.182,
  "source": "whisper"
 },
 {
  "start": 120.4,
  "end": 124.6,
  "text": "We recognize our responsibility to serve as stewards for the land and honor the original",
  "no_speech": 0.0,
  "logprob": -0.182,
  "source": "whisper"
 },
 {
  "start": 124.6,
  "end": 127.2,
  "text": "caretakers who came before us.",
  "no_speech": 0.0,
  "logprob": -0.182,
  "source": "whisper"
 },
 {
  "start": 127.2,
  "end": 130.9,
  "text": "Our community is enriched by the enduring knowledge and deep-rooted traditions of the",
  "no_speech": 0.0,
  "logprob": -0.182,
  "source": "whisper"
 },
 {
  "start": 130.9,
  "end": 135.8,
  "text": "diverse First Nations, Métis and Inuit in Kitchener today.",
  "no_speech": 0.0,
  "logprob": -0.182,
  "source": "whisper"
 },
 {
  "start": 135.8,
  "end": 140.0,
  "text": "Happy New Year to everyone who's watching us on this live stream.",
  "no_speech": 0.0,
  "logprob": -0.182,
  "source": "whisper"
 },
 {
  "start": 140.0,
  "end": 147.1,
  "text": "We have two items of business today, but before I begin, are there any disclosures of pecuniary",
