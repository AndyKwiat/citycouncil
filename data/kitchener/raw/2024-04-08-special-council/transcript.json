[
 {
  "start": 0.0,
  "end": 4.0,
  "text": "Good evening, everyone, and welcome to today's special council meeting on April 8th.",
  "no_speech": 0.0,
  "logprob": -0.223,
  "source": "whisper"
 },
 {
  "start": 4.9,
  "end": 17.8,
  "text": "Individuals interested in participating in this meeting were eligible to register online using the delegation registration form at www.kitchener.ca or via email at delegation at kitchener.ca.",
  "no_speech": 0.0,
  "logprob": -0.223,
  "source": "whisper"
 },
 {
  "start": 18.6,
  "end": 26.1,
  "text": "Any written comments received prior to the commencement of this meeting will be circulated prior to the meeting and will form part of the public record.",
  "no_speech": 0.0,
  "logprob": -0.223,
  "source": "whisper"
 },
 {
  "start": 26.1,
  "end": 36.7,
  "text": "As we begin this evening's special council meeting, I'd like to acknowledge that this evening we're gathering on the traditional territory of the neutral Anishinaabe and Haudenosaunee peoples.",
  "no_speech": 0.0,
  "logprob": -0.191,
  "source": "whisper"
 },
 {
  "start": 37.0,
  "end": 42.8,
  "text": "We recognize our responsibility to serve as stewards for the land and honor the original caretakers who came before us.",
  "no_speech": 0.0,
  "logprob": -0.191,
  "source": "whisper"
 },
 {
  "start": 43.4,
  "end": 50.4,
  "text": "Our community is enriched by the enduring knowledge and deep-rooted traditions of the diverse First Nations, Métis, and Inuit in Kitchener today.",
  "no_speech": 0.0,
  "logprob": -0.191,
  "source": "whisper"
 },
 {
