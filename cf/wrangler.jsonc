// The public site at cityhallvotes.ca: Cloudflare serves the static files for free, and this Worker handles
// the two things files can't: redirecting www, and forwarding searches to the private API with its secret key.
{
  "name": "cityhallvotes",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../state/cf/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "cityhallvotes.ca", "custom_domain": true },
    { "pattern": "www.cityhallvotes.ca", "custom_domain": true }
  ],
  "vars": { "API_ORIGIN": "https://api-citycouncil.akwiat.com" },
  // Free on Cloudflare: each visitor (by IP) gets 15 searches a minute before reaching the server at all.
  "ratelimits": [{ "name": "SEARCH_LIMIT", "namespace_id": "1001", "simple": { "limit": 15, "period": 60 } }],
  // Request logs in the Cloudflare dashboard (Workers & Pages > cityhallvotes > Logs), including cached searches.
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false
}
